# Application
APP_URL=http://localhost:3003
NODE_ENV=development
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64

# Local Docker MariaDB (pnpm db:local:setup generates passwords)
DB_HOST=127.0.0.1
DB_PORT=13308
DB_NAME=n7cosmetics
DB_USER=n7cosmetics
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Initial administrator (used only by pnpm db:create-admin)
ADMIN_NAME=N7 Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Admin sessions
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false

# Private media storage. Relative paths resolve from the application root.
# Local development: media
# Production (one directory above the application): ../media
MEDIA_STORAGE_DIR=media

{
  "name": "n7cosmetics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "build:deploy": "next build && tsc -p tsconfig.scripts.json",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-deployment-zip.ps1",
    "deploy:package": "npm run build:deploy && npm run package:deploy",
    "start": "node server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .tests-dist/tests/admin-form.test.js .tests-dist/tests/destination.test.js .tests-dist/tests/commerce-validation.test.js .tests-dist/tests/review-validation.test.js .tests-dist/tests/auth-password.test.js .tests-dist/tests/contact-email.test.js",
    "db:migrate": "tsc -p tsconfig.scripts.json && node .scripts-dist/scripts/migrate.js",
    "db:create-admin": "tsc -p tsconfig.scripts.json && node .scripts-dist/scripts/create-admin.js",
    "db:seed": "tsc -p tsconfig.scripts.json && node .scripts-dist/scripts/seed.js",
    "db:migrate:deploy": "node .scripts-dist/scripts/migrate.js",
    "db:create-admin:deploy": "node .scripts-dist/scripts/create-admin.js",
    "db:seed:deploy": "node .scripts-dist/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "lucide-react": "1.23.0",
    "motion": "12.42.2",
    "mysql2": "3.23.4",
    "next": "16.3.1",
    "nodemailer": "9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "2.6.0",
    "react-icons": "5.7.0",
    "swiper": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  }
}
